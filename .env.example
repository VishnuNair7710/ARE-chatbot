# LLM (Groq free tier). Variable names are fixed by the assignment brief.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your-groq-key-here
LLM_BASE_URL=

# Embeddings: Groq has none, so use a local model (no key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=

# Optional
STRICT_FLOW=false
ENABLE_LANE_C=true
MAX_TURNS=100
LEAD_DB_PATH=leads.db
CHECKPOINT_DB=            # set a path to keep chat sessions across restarts
TURN_LOG_PATH=turns.jsonl # one JSON line per turn (latency, tokens, cost); never contains chat text
LLM_PRICE_IN_PER_MTOK=0   # USD per million tokens, for cost estimates (0 on free tiers)
LLM_PRICE_OUT_PER_MTOK=0
API_RATE_LIMIT=30         # requests per minute per client
API_URL=http://localhost:8000   # used by the Streamlit UI

# Optional tracing (Langfuse). LangSmith works via its own LANGCHAIN_* variables.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
